APP_ENV=development
# Compose sends verification links to local Mailpit only; unverified accounts can still sign in.
EMAIL_VERIFICATION_ENABLED=true
# Local Compose mail defaults to Mailpit. To opt in to authenticated external SMTP,
# set MAIL_TRANSPORT=smtp and configure the fields below using secret management.
# SMTP_SECURITY must be starttls or tls, and APP_PUBLIC_URL must be an HTTPS origin.
# MAIL_TRANSPORT=smtp
# SMTP_HOST=mail.example.test
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_USERNAME=
# SMTP_PASSWORD=
# MAIL_FROM=noreply@example.test
# APP_PUBLIC_URL=https://mediagent.example.test
# Set to independent to require a different authorized doctor to approve or reject a note.
NOTE_REVIEW_POLICY=self_or_independent
KNOWLEDGE_REVIEW_POLICY=self_or_independent
KNOWLEDGE_CLINICAL_REVIEW_POLICY=optional
DATABASE_URL=postgresql+asyncpg://mediagent:mediagent@db:5432/mediagent
JWT_SECRET=replace-with-at-least-32-random-bytes
UPLOAD_DIR=/data/uploads
# Patient documents use local storage by default. An S3 option is experimental;
# configure the same endpoint, region, bucket, and credentials in API, worker, and purger.
DOCUMENT_STORAGE_BACKEND=local
# S3_ENDPOINT_URL=https://s3.example.test
# S3_REGION=us-east-1
# S3_BUCKET=private-versioned-bucket
MAX_UPLOAD_BYTES=10485760
# OCR stays local; alternate language packs must be installed in the worker.
OCR_PROVIDER=tesseract
TESSERACT_LANGS=eng
# fallback OCRs pages without native text; all also OCRs pages with native text.
PDF_OCR_MODE=fallback
# disabled is unscanned local development; clamd requires a trusted mounted Unix socket.
MALWARE_SCAN_MODE=disabled
CLAMD_SOCKET=
# Optional local Ollama embedding service; leave blank to disable semantic indexing/search.
OLLAMA_BASE_URL=
OLLAMA_EMBED_MODEL=all-minilm
# Optional vision transcription. Disabled unless explicitly configured and requested by the patient.
VISION_PROVIDER=disabled
OLLAMA_VISION_MODEL=
# Optional chat model. No assistant model is enabled unless explicitly set.
OLLAMA_CHAT_MODEL=
WS_ALLOWED_ORIGINS=http://localhost:3100,http://127.0.0.1:3100
